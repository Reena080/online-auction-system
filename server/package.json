{
  "name": "online-auction-server",
  "version": "1.0.0",
  "description": "Online Auction System Backend with PostgreSQL concurrency control, Redis caching/rate-limiting, and MongoDB audit logging",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "node migrations/runMigrations.js",
    "seed": "node migrations/seed.js",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "test:coverage": "jest --runInBand --coverage --detectOpenHandles --forceExit"
  },
  "keywords": [
    "auction",
    "concurrency",
    "postgresql",
    "redis",
    "mongodb",
    "express"
  ],
  "author": "Bellcorp Placement Candidate",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.8.0",
    "pg": "^8.12.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "ioredis-mock": "^8.9.0",
    "jest": "^29.7.0",
    "mime": "^2.6.0",
    "nodemon": "^3.1.4",
    "pg-mem": "^2.8.1",
    "supertest": "^6.3.4"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 15000,
    "verbose": true,
    "roots": [
      "<rootDir>/../tests"
    ],
    "moduleDirectories": [
      "node_modules",
      "<rootDir>/node_modules"
    ],
    "testMatch": [
      "**/*.test.js"
    ]
  }
}
